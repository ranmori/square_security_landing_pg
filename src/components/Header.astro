---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { serviceIcons } from './icons';
import { company, phoneLabel } from '../data/company';
import { pagePath, servicePath, useTranslations, type Alternates, type Lang } from '../i18n/ui';
import { getServices } from '../lib/services';

interface Props {
  lang: Lang;
  alternates: Alternates | null;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'de' ? 'en' : 'de';
const switchHref = alternates?.[otherLang] ?? pagePath('home', otherLang);
const services = await getServices(lang);

const path = Astro.url.pathname;
const servicesHref = pagePath('services', lang);
const contactHref = pagePath('contact', lang);
const isServices = path.startsWith(servicesHref);
const isContact = path === contactHref;
const phone = phoneLabel(lang);
---

<header
  class="sticky top-0 z-40 border-b border-navy-100 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85"
  style="view-transition-name: site-header"
>
  <div class="container-page flex h-18 items-center justify-between gap-6">
    <a href={pagePath('home', lang)} class="shrink-0">
      <Logo class="h-10 w-auto sm:h-11" alt={`Square Security – ${t.nav.home}`} />
    </a>

    <nav aria-label={t.nav.mainNav} class="hidden lg:block">
      <ul class="flex items-center gap-8 text-sm font-medium">
        <li class="group relative">
          <a href={servicesHref} class="nav-link" aria-current={isServices ? 'page' : undefined}>
            {t.nav.services}
            <Icon name="chevronDown" class="size-4 transition group-hover:rotate-180" />
          </a>
          <div
            class="invisible absolute top-full left-1/2 z-50 w-80 -translate-x-1/2 pt-3 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100"
          >
            <ul class="rounded-xl border border-navy-100 bg-white p-2 shadow-xl shadow-navy-900/10">
              {
                services.map((service) => (
                  <li>
                    <a
                      href={servicePath(service.data.key, lang)}
                      class="flex items-center gap-3 rounded-lg px-3 py-2.5 hover:bg-navy-50"
                    >
                      <span class="grid size-9 place-items-center rounded-lg bg-brand-50 text-brand-700">
                        <Icon name={serviceIcons[service.data.key]} class="size-5" />
                      </span>
                      <span class="font-medium text-navy-900">{service.data.navTitle}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        <li>
          <a href={contactHref} class="nav-link" aria-current={isContact ? 'page' : undefined}>{t.nav.contact}</a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={`tel:${company.phoneE164}`}
        class="hidden items-center gap-2 text-sm font-semibold text-navy-900 hover:text-navy-600 xl:inline-flex"
      >
        <Icon name="phone" class="size-4 text-brand-600" />
        {phone}
      </a>
      <a
        href={switchHref}
        hreflang={otherLang}
        lang={otherLang}
        aria-label={t.nav.switchLanguage}
        class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-2 text-sm font-semibold text-navy-700 hover:bg-navy-50 hover:text-navy-900"
      >
        <Icon name="globe" class="size-4" />
        {otherLang.toUpperCase()}
      </a>
      <a href={contactHref} class="btn btn-primary hidden sm:inline-flex">{t.nav.requestQuote}</a>
      <button
        type="button"
        class="menu-toggle grid size-10 place-items-center rounded-lg text-navy-900 hover:bg-navy-50 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.openMenu}
        data-label-open={t.nav.openMenu}
        data-label-close={t.nav.closeMenu}
      >
        <span class="icon-open"><Icon name="menu" class="size-6" /></span>
        <span class="icon-close hidden"><Icon name="close" class="size-6" /></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-navy-100 bg-white lg:hidden" hidden>
    <nav aria-label={t.nav.mainNav} class="container-page py-4">
      <ul class="space-y-1">
        <li><a href={pagePath('home', lang)} class="mobile-link">{t.nav.home}</a></li>
        <li>
          <a href={servicesHref} class="mobile-link">{t.nav.services}</a>
          <ul class="mt-1 ml-3 space-y-1 border-l border-navy-100 pl-3">
            {
              services.map((service) => (
                <li>
                  <a href={servicePath(service.data.key, lang)} class="mobile-link text-sm text-navy-600">
                    {service.data.navTitle}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        <li><a href={contactHref} class="mobile-link">{t.nav.contact}</a></li>
      </ul>
      <div class="mt-4 grid gap-2 sm:grid-cols-2">
        <a href={`tel:${company.phoneE164}`} class="btn btn-outline">
          <Icon name="phone" class="size-4" />
          {phone}
        </a>
        <a href={contactHref} class="btn btn-primary">{t.nav.requestQuote}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    if (!menu) return;
    const open = menu.hidden;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  });
</script>
