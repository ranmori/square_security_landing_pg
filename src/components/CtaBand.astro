---
import Icon from './Icon.astro';
import { company, phoneLabel } from '../data/company';
import { pagePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="bg-white py-16 sm:py-20">
  <div class="container-page">
    <div
      class="relative overflow-hidden rounded-3xl bg-navy-900 px-6 py-12 sm:px-12 sm:py-14 lg:flex lg:items-center lg:justify-between lg:gap-10"
    >
      <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-brand-500/15 blur-3xl">
      </div>
      <div class="relative max-w-2xl">
        <h2 class="text-3xl font-bold text-white sm:text-4xl">{t.cta.title}</h2>
        <p class="mt-3 text-lg text-navy-200">{t.cta.text}</p>
      </div>
      <div class="relative mt-8 flex flex-col gap-3 sm:flex-row lg:mt-0 lg:shrink-0">
        <a href={pagePath('contact', lang)} class="btn btn-primary btn-lg">
          {t.cta.button}
          <Icon name="arrowRight" class="size-4" />
        </a>
        <a href={`tel:${company.phoneE164}`} class="btn btn-ghost-light btn-lg">
          <Icon name="phone" class="size-4" />
          {phoneLabel(lang)}
        </a>
      </div>
    </div>
  </div>
</section>
