---
import Icon from './Icon.astro';
import { serviceIcons } from './icons';
import { servicePath, useTranslations, type Lang } from '../i18n/ui';
import type { ServiceEntry } from '../lib/services';

interface Props {
  service: ServiceEntry;
  lang: Lang;
  headingLevel?: 'h2' | 'h3';
}

const { service, lang, headingLevel: Heading = 'h3' } = Astro.props;
const t = useTranslations(lang);
---

<a
  href={servicePath(service.data.key, lang)}
  class="group flex h-full flex-col rounded-2xl border border-navy-100 bg-white p-6 transition hover:-translate-y-0.5 hover:border-navy-200 hover:shadow-xl hover:shadow-navy-900/5 sm:p-7"
>
  <span
    class="grid size-12 place-items-center rounded-xl bg-navy-900 text-brand-500 transition group-hover:bg-brand-500 group-hover:text-navy-900"
    style={`view-transition-name: service-icon-${service.data.key}`}
  >
    <Icon name={serviceIcons[service.data.key]} class="size-6" />
  </span>
  <Heading
    class="mt-5 w-fit text-lg font-bold"
    style={`view-transition-name: service-title-${service.data.key}; view-transition-class: service-title`}
  >
    {service.data.navTitle}
  </Heading>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-navy-500">{service.data.summary}</p>
  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-navy-900">
    {t.services.learnMore}
    <Icon name="arrowRight" class="size-4 text-brand-600 transition group-hover:translate-x-1" />
  </span>
</a>
