---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import ServiceCard from '../ServiceCard.astro';
import CtaBand from '../CtaBand.astro';
import { company, phoneLabel } from '../../data/company';
import { pagePath, serviceAlternates, useTranslations, type Lang } from '../../i18n/ui';
import { getServices, type ServiceEntry } from '../../lib/services';

interface Props {
  lang: Lang;
  service: ServiceEntry;
}

const { lang, service } = Astro.props;
const t = useTranslations(lang);
const data = service.data;
const { Content } = await render(service);
const others = (await getServices(lang)).filter((entry) => entry.data.key !== data.key);
const phone = phoneLabel(lang);

const faqSchema =
  data.faq.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: data.faq.map((item) => ({
            '@type': 'Question',
            name: item.question,
            acceptedAnswer: { '@type': 'Answer', text: item.answer },
          })),
        },
      ]
    : [];
---

<BaseLayout
  lang={lang}
  title={data.metaTitle}
  description={data.metaDescription}
  alternates={serviceAlternates(data.key)}
  jsonLd={faqSchema}
>
  <PageHero
    lang={lang}
    eyebrow={t.services.eyebrow}
    title={data.title}
    lead={data.summary}
    crumbs={[
      { label: t.nav.home, href: pagePath('home', lang) },
      { label: t.nav.services, href: pagePath('services', lang) },
      { label: data.navTitle },
    ]}
  >
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={pagePath('contact', lang)} class="btn btn-primary btn-lg">
        {t.nav.requestQuote}
        <Icon name="arrowRight" class="size-4" />
      </a>
      <a href={`tel:${company.phoneE164}`} class="btn btn-outline btn-lg">
        <Icon name="phone" class="size-4" />
        {phone}
      </a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <div class="prose-content text-lg">
          <Content />
        </div>

        <div class="mt-12">
          <h2 class="text-2xl font-bold">{t.services.audienceTitle}</h2>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {
              data.audience.map((item) => (
                <li class="flex items-center gap-3 rounded-xl border border-navy-100 px-4 py-3 text-navy-700">
                  <Icon name="check" class="size-5 shrink-0 text-brand-600" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <aside class="lg:col-span-5">
        <div class="space-y-6 lg:sticky lg:top-28">
          <div class="rounded-2xl border border-navy-100 bg-navy-50/60 p-6 sm:p-8">
            <h2 class="text-xl font-bold">{t.services.highlightsTitle}</h2>
            <ul class="mt-5 space-y-3">
              {
                data.highlights.map((item) => (
                  <li class="flex gap-3 text-navy-700">
                    <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-brand-500 text-navy-900">
                      <Icon name="check" class="size-3.5" strokeWidth={2.5} />
                    </span>
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="rounded-2xl bg-navy-900 p-6 text-navy-200 sm:p-8">
            <h2 class="text-xl font-bold text-white">{t.services.asideTitle}</h2>
            <p class="mt-2 text-sm leading-relaxed">{t.services.asideText}</p>
            <div class="mt-6 flex flex-col gap-3">
              <a href={pagePath('contact', lang)} class="btn btn-primary">{t.nav.requestQuote}</a>
              <a href={`tel:${company.phoneE164}`} class="btn btn-ghost-light">
                <Icon name="phone" class="size-4" />
                {phone}
              </a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {
    data.faq.length > 0 && (
      <section class="section border-y border-navy-100 bg-navy-50/60">
        <div class="container-page max-w-3xl">
          <h2 class="text-center text-3xl font-bold sm:text-4xl">{t.services.faqTitle}</h2>
          <div class="mt-10 space-y-3">
            {data.faq.map((item) => (
              <details class="group rounded-xl border border-navy-100 bg-white">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold text-navy-900">
                  {item.question}
                  <Icon name="chevronDown" class="size-5 shrink-0 text-navy-400 transition group-open:rotate-180" />
                </summary>
                <p class="px-5 pb-5 leading-relaxed text-navy-600">{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container-page">
      <h2 class="text-3xl font-bold sm:text-4xl">{t.services.otherTitle}</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {others.map((entry) => <ServiceCard service={entry} lang={lang} />)}
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
