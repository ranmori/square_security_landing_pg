---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import ApplicationForm from '../ApplicationForm.astro';
import type { IconName } from '../icons';
import { pageAlternates, pagePath, useTranslations, type Lang } from '../../i18n/ui';
import { getJobs, type JobEntry } from '../../lib/services';
import { breadcrumbJsonLd, jobPostingJsonLd } from '../../lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.careers;
const jobs = await getJobs(lang);
const site = Astro.site ?? new URL('https://square-security.de');
const careersPath = pagePath('careers', lang);

const crumbs = [{ label: t.nav.home, href: pagePath('home', lang) }, { label: t.nav.careers }];
const jsonLd = [
  breadcrumbJsonLd(crumbs, site, careersPath),
  ...jobs.map((job) => jobPostingJsonLd(job.data, site, `${careersPath}#job-${job.data.key}`)),
];

const benefitIcons: IconName[] = ['clipboard', 'calendar', 'route', 'userCheck'];
const jobSections = (job: JobEntry) => [
  { heading: c.tasksTitle, items: job.data.tasks },
  { heading: c.requirementsTitle, items: job.data.requirements },
  { heading: c.offerTitle, items: job.data.offer },
];
---

<BaseLayout lang={lang} title={c.metaTitle} description={c.metaDescription} alternates={pageAlternates('careers')} jsonLd={jsonLd}>
  <PageHero lang={lang} eyebrow={c.eyebrow} title={c.title} lead={c.lead} crumbs={crumbs}>
    <div class="mt-8">
      <a href="#application" class="btn btn-primary btn-lg">
        {c.applyNow}
        <Icon name="arrowRight" class="size-4" />
      </a>
    </div>
  </PageHero>

  <section class="section bg-white">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">{c.benefitsEyebrow}</p>
        <h2 class="section-title">{c.benefitsTitle}</h2>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          c.benefits.map((benefit, index) => (
            <li class="rounded-2xl border border-navy-100 bg-white p-6">
              <span class="grid size-11 place-items-center rounded-xl bg-navy-900 text-brand-500">
                <Icon name={benefitIcons[index] ?? 'check'} class="size-5" />
              </span>
              <h3 class="mt-4 text-lg font-bold">{benefit.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy-500">{benefit.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section border-y border-navy-100 bg-navy-50/60">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">{c.openingsEyebrow}</p>
        <h2 class="section-title">{c.openingsTitle}</h2>
      </div>
      <div class="mt-12 space-y-6">
        {
          jobs.map((job) => (
            <article id={`job-${job.data.key}`} class="scroll-mt-28 rounded-3xl border border-navy-100 bg-white p-6 shadow-xl shadow-navy-900/5 sm:p-10">
              <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
                <div>
                  <h3 class="text-2xl font-bold sm:text-3xl">{job.data.title}</h3>
                  <div class="mt-3 flex flex-wrap gap-2 text-sm">
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-navy-50 px-3 py-1 text-navy-700">
                      <Icon name="mapPin" class="size-4 text-brand-600" />
                      {job.data.location}
                    </span>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-navy-50 px-3 py-1 text-navy-700">
                      <Icon name="clock" class="size-4 text-brand-600" />
                      {job.data.employmentLabel}
                    </span>
                  </div>
                  <p class="mt-4 max-w-2xl text-lg leading-relaxed text-navy-500">{job.data.summary}</p>
                </div>
                <a href="#application" class="btn btn-primary btn-lg shrink-0 self-start">
                  {c.applyNow}
                  <Icon name="arrowRight" class="size-4" />
                </a>
              </div>
              <div class="mt-8 grid gap-8 md:grid-cols-3">
                {jobSections(job).map((section) => (
                  <div>
                    <h4 class="font-display text-lg font-bold text-navy-900">{section.heading}</h4>
                    <ul class="mt-4 space-y-3">
                      {section.items.map((item) => (
                        <li class="flex gap-3 text-sm leading-relaxed text-navy-700">
                          <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-brand-500 text-navy-900">
                            <Icon name="check" class="size-3.5" strokeWidth={2.5} />
                          </span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="application" class="section scroll-mt-20 bg-white">
    <div class="container-page max-w-3xl">
      <p class="eyebrow">{c.form.eyebrow}</p>
      <h2 class="section-title">{c.form.title}</h2>
      <p class="section-lead">{c.form.lead}</p>
      <div class="mt-10 rounded-2xl border border-navy-100 bg-white p-6 shadow-xl shadow-navy-900/5 sm:p-10">
        <ApplicationForm lang={lang} jobs={jobs} />
      </div>
    </div>
  </section>
</BaseLayout>
