---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuardScene from '../illustrations/GuardScene.astro';
import Icon from '../Icon.astro';
import ServiceCard from '../ServiceCard.astro';
import CustomServiceCard from '../CustomServiceCard.astro';
import CtaBand from '../CtaBand.astro';
import PatrolTimeline from '../PatrolTimeline.astro';
import type { IconName } from '../icons';
import { company, phoneLabel } from '../../data/company';
import { pageAlternates, pagePath, useTranslations, type Lang } from '../../i18n/ui';
import { getServices } from '../../lib/services';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const h = t.home;
const services = await getServices(lang);
const trustIcons: IconName[] = ['award', 'calendar', 'globe', 'shieldCheck'];
const whyIcons: IconName[] = ['chat', 'userCheck', 'sliders', 'clipboard'];
---

<BaseLayout lang={lang} alternates={pageAlternates('home')}>
  <section class="relative overflow-hidden bg-navy-50/60">
    <div aria-hidden="true" class="hero-grid pointer-events-none absolute inset-0"></div>
    <div class="container-page relative grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:gap-16 lg:py-28">
      <div class="lg:col-span-7">
        <p class="eyebrow">{h.eyebrow}</p>
        <h1 class="mt-5 text-4xl leading-[1.08] font-extrabold sm:text-5xl lg:text-6xl">{h.title}</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-navy-500 sm:text-xl">{h.lead}</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={pagePath('contact', lang)} class="btn btn-primary btn-lg">
            {h.primaryCta}
            <Icon name="arrowRight" class="size-4" />
          </a>
          <a href={pagePath('services', lang)} class="btn btn-outline btn-lg">{h.secondaryCta}</a>
        </div>
        <a
          href={`tel:${company.phoneE164}`}
          class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-navy-600 hover:text-navy-900"
        >
          <Icon name="phone" class="size-4 text-brand-600" />
          {h.callHint} <span class="font-semibold text-navy-900">{phoneLabel(lang)}</span>
        </a>
      </div>

      <div class="lg:col-span-5">
        <div class="relative overflow-hidden rounded-3xl bg-navy-900 shadow-2xl shadow-navy-900/20">
          <GuardScene lang={lang} />
          <div
            class="absolute inset-x-3 bottom-3 rounded-2xl border border-white/10 bg-navy-950/75 p-4 backdrop-blur-sm sm:inset-x-4 sm:bottom-4"
          >
            <p class="font-display text-sm font-semibold text-white">{h.heroCardTitle}</p>
            <ul class="mt-2 grid gap-1 text-xs text-navy-200">
              <li class="flex items-center gap-2">
                <Icon name="mapPin" class="size-4 shrink-0 text-brand-500" />
                {company.street}, {company.postalCode} {company.city}
              </li>
              <li class="flex items-center gap-2">
                <Icon name="clock" class="size-4 shrink-0 text-brand-500" />
                {t.hours[0].days}: {t.hours[0].time}
              </li>
              <li class="flex items-center gap-2">
                <Icon name="mail" class="size-4 shrink-0 text-brand-500" />
                <a href={`mailto:${company.email}`} class="hover:text-white">{company.email}</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-navy-100 bg-white">
    <ul class="container-page grid gap-6 py-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        h.trust.map((item, index) => (
          <li class="flex items-start gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-700">
              <Icon name={trustIcons[index] ?? 'shieldCheck'} class="size-5" />
            </span>
            <div>
              <p class="font-display font-bold text-navy-900">{item.title}</p>
              <p class="mt-0.5 text-sm text-navy-500">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">{h.servicesEyebrow}</p>
        <h2 class="section-title">{h.servicesTitle}</h2>
        <p class="section-lead">{h.servicesLead}</p>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => <ServiceCard service={service} lang={lang} />)}
        <CustomServiceCard lang={lang} />
      </div>
    </div>
  </section>

  <section class="section bg-navy-50/60">
    <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">{h.whyEyebrow}</p>
        <h2 class="section-title">{h.whyTitle}</h2>
        <p class="section-lead">{h.whyLead}</p>
      </div>
      <ul class="grid gap-5 sm:grid-cols-2 lg:col-span-7">
        {
          h.why.map((item, index) => (
            <li class="rounded-2xl border border-navy-100 bg-white p-6">
              <span class="grid size-11 place-items-center rounded-xl bg-navy-900 text-brand-500">
                <Icon name={whyIcons[index] ?? 'check'} class="size-5" />
              </span>
              <h3 class="mt-4 text-lg font-bold">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy-500">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">{h.referencesEyebrow}</p>
        <h2 class="section-title">{h.referencesTitle}</h2>
        <p class="section-lead">{h.referencesLead}</p>
      </div>
      <ul class="mt-12 grid gap-5 md:grid-cols-2">
        {
          h.references.map((reference) => (
            <li class="flex gap-5 rounded-2xl border border-navy-100 p-6 sm:p-8">
              <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-700">
                <Icon name="calendar" class="size-6" />
              </span>
              <div>
                <p class="text-xs font-semibold tracking-wider text-brand-700 uppercase">{reference.meta}</p>
                <h3 class="mt-1 text-xl font-bold">{reference.title}</h3>
                <p class="mt-2 text-navy-500">{reference.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bg-navy-50/60">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">{h.processEyebrow}</p>
        <h2 class="section-title">{h.processTitle}</h2>
      </div>
      <div class="mt-16 md:mt-24">
        <PatrolTimeline steps={h.process} />
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
