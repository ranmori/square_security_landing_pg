---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import ContactForm from '../ContactForm.astro';
import { company, phoneLabel } from '../../data/company';
import { pageAlternates, pagePath, useTranslations, type Lang } from '../../i18n/ui';
import { breadcrumbJsonLd } from '../../lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.contact;
const site = Astro.site ?? new URL('https://square-security.de');
const crumbs = [{ label: t.nav.home, href: pagePath('home', lang) }, { label: t.nav.contact }];
---

<BaseLayout
  lang={lang}
  title={c.metaTitle}
  description={c.metaDescription}
  alternates={pageAlternates('contact')}
  jsonLd={[breadcrumbJsonLd(crumbs, site, pagePath('contact', lang))]}
  ogImage={`/og/contact-${lang}.png`}
>
  <PageHero
    lang={lang}
    eyebrow={c.eyebrow}
    title={c.title}
    lead={c.lead}
    crumbs={crumbs}
  />

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h2 class="text-2xl font-bold">{c.detailsTitle}</h2>
        <ul class="mt-8 space-y-6">
          <li class="flex gap-4">
            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-navy-900 text-brand-500">
              <Icon name="phone" class="size-5" />
            </span>
            <div>
              <p class="text-sm text-navy-500">{c.phone}</p>
              <a href={`tel:${company.phoneE164}`} class="text-lg font-semibold text-navy-900 hover:text-navy-600">
                {phoneLabel(lang)}
              </a>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-navy-900 text-brand-500">
              <Icon name="mail" class="size-5" />
            </span>
            <div>
              <p class="text-sm text-navy-500">{c.email}</p>
              <a href={`mailto:${company.email}`} class="text-lg font-semibold break-all text-navy-900 hover:text-navy-600">
                {company.email}
              </a>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-navy-900 text-brand-500">
              <Icon name="mapPin" class="size-5" />
            </span>
            <div>
              <p class="text-sm text-navy-500">{c.address}</p>
              <address class="text-lg font-semibold text-navy-900 not-italic">
                {company.legalName}<br />{company.street}<br />{company.postalCode} {company.city}
              </address>
              <a
                href={company.mapsUrl}
                target="_blank"
                rel="noopener"
                class="mt-1 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-navy-900"
              >
                {c.directions}
                <Icon name="arrowRight" class="size-4" />
              </a>
            </div>
          </li>
        </ul>

        <div class="mt-10 rounded-2xl border border-navy-100 bg-navy-50/60 p-6">
          <h3 class="flex items-center gap-2 text-lg font-bold">
            <Icon name="clock" class="size-5 text-brand-600" />
            {c.hoursTitle}
          </h3>
          <dl class="mt-4 space-y-2 text-sm">
            {
              t.hours.map((entry) => (
                <div class="flex justify-between gap-4 border-b border-navy-100 pb-2 last:border-0 last:pb-0">
                  <dt class="text-navy-600">{entry.days}</dt>
                  <dd class="font-semibold text-navy-900">{entry.time}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-navy-100 bg-white p-6 shadow-xl shadow-navy-900/5 sm:p-10">
          <h2 class="text-2xl font-bold">{c.form.title}</h2>
          <div class="mt-8">
            <ContactForm lang={lang} />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
