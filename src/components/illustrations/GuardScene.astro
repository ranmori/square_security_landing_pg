---
import GuardFigure from './GuardFigure.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);

interface Building {
  x: number;
  y: number;
  w: number;
  h: number;
}

const groundY = 346;
const backBuildings: Building[] = [
  { x: 8, y: 196, w: 66, h: 170 },
  { x: 84, y: 150, w: 52, h: 216 },
  { x: 238, y: 176, w: 62, h: 190 },
  { x: 310, y: 214, w: 84, h: 152 },
];
const frontBuildings: Building[] = [
  { x: -4, y: 250, w: 58, h: 116 },
  { x: 140, y: 226, w: 70, h: 140 },
  { x: 348, y: 262, w: 60, h: 104 },
];

// Deterministic window pattern: some lit, a few of those blink slowly.
function windowsFor(buildings: Building[], layer: number) {
  return buildings.flatMap((b, bi) => {
    const cols = Math.max(1, Math.floor((b.w - 10) / 13));
    const rows = Math.floor((b.h - 20) / 20);
    return Array.from({ length: cols * rows }, (_, n) => {
      const col = n % cols;
      const row = Math.floor(n / cols);
      const x = b.x + 8 + col * 13;
      const y = b.y + 14 + row * 20;
      const seed = col * 7 + row * 5 + bi * 3 + layer;
      const lit = seed % 4 === 0;
      return {
        x,
        y,
        lit,
        blink: lit && (col + row + bi) % 3 === 0,
        delay: ((col * 3 + row * 5 + bi) % 7) * 0.9,
      };
    }).filter((w) => w.y + 8 < groundY);
  });
}

const backWindows = windowsFor(backBuildings, 0);
const frontWindows = windowsFor(frontBuildings, 1);

const stars = [
  [34, 48, 1.6],
  [86, 26, 1.2],
  [142, 64, 1.4],
  [204, 34, 1.1],
  [252, 112, 1.3],
  [372, 160, 1.2],
  [112, 122, 1],
  [362, 34, 1.1],
  [20, 150, 1.1],
];
---

<svg
  viewBox="0 0 400 470"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={t.home.illustrationAlt}
  class:list={['guard-idle-scene block h-auto w-full', className]}
>
  <defs>
    <linearGradient id="scene-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0E182D"></stop>
      <stop offset="1" stop-color="#22325A"></stop>
    </linearGradient>
    <radialGradient id="scene-moon-glow">
      <stop offset="0" stop-color="#F3E9D2" stop-opacity="0.35"></stop>
      <stop offset="1" stop-color="#F3E9D2" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="scene-guard-glow">
      <stop offset="0" stop-color="#4A62A0" stop-opacity="0.5"></stop>
      <stop offset="1" stop-color="#4A62A0" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <rect width="400" height="470" fill="url(#scene-sky)"></rect>

  <circle cx="316" cy="86" r="76" fill="url(#scene-moon-glow)"></circle>
  <circle cx="316" cy="86" r="24" fill="#F3E9D2"></circle>
  <circle cx="309" cy="80" r="4.5" fill="#E3D6B9"></circle>
  <circle cx="324" cy="94" r="3" fill="#E3D6B9"></circle>

  {
    stars.map(([cx, cy, r], i) => (
      <circle class="scene-star" cx={cx} cy={cy} r={r} fill="#F3E9D2" style={`animation-delay: ${i * 0.45}s`} />
    ))
  }

  {backBuildings.map((b) => <rect x={b.x} y={b.y} width={b.w} height={b.h} fill="#16223F" />)}
  {
    backWindows.map((w) => (
      <rect
        class:list={[{ 'scene-window-blink': w.blink }]}
        x={w.x}
        y={w.y}
        width="6"
        height="8"
        rx="1"
        fill={w.lit ? '#F7981D' : '#22315A'}
        opacity={w.lit ? 0.85 : 1}
        style={w.blink ? `animation-delay: ${w.delay}s` : undefined}
      />
    ))
  }

  {frontBuildings.map((b) => <rect x={b.x} y={b.y} width={b.w} height={b.h} fill="#0C1529" />)}
  {
    frontWindows.map((w) => (
      <rect
        class:list={[{ 'scene-window-blink': w.blink }]}
        x={w.x}
        y={w.y}
        width="6"
        height="8"
        rx="1"
        fill={w.lit ? '#F7981D' : '#18223A'}
        opacity={w.lit ? 0.8 : 1}
        style={w.blink ? `animation-delay: ${w.delay}s` : undefined}
      />
    ))
  }

  <ellipse cx="198" cy="250" rx="118" ry="136" fill="url(#scene-guard-glow)"></ellipse>

  <rect x="0" y={groundY} width="400" height={470 - groundY} fill="#080E1C"></rect>
  <rect x="0" y={groundY} width="400" height="2" fill="#22325A"></rect>

  <ellipse cx="200" cy={groundY + 1} rx="36" ry="5" fill="#000000" opacity="0.3"></ellipse>
  <g transform="translate(122 106) scale(1.25)">
    <GuardFigure beam />
  </g>
</svg>

<style>
  .scene-star {
    animation: scene-twinkle 3.2s ease-in-out infinite alternate;
  }

  .scene-window-blink {
    animation: scene-window 7s steps(1) infinite;
  }

  @keyframes scene-twinkle {
    from {
      opacity: 0.25;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes scene-window {
    0%,
    70% {
      opacity: 0.85;
    }

    71%,
    85% {
      opacity: 0.15;
    }

    86%,
    100% {
      opacity: 0.85;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-star,
    .scene-window-blink {
      animation: none;
    }
  }
</style>
