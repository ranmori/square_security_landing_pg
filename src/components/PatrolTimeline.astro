---
import Icon from './Icon.astro';
import GuardFigure from './illustrations/GuardFigure.astro';

interface Props {
  steps: { title: string; text: string }[];
}

const { steps } = Astro.props;
---

<div class="patrol relative" data-patrol>
  <div class="patrol-guard" aria-hidden="true">
    <svg viewBox="0 0 120 200" overflow="visible" class="block h-full w-full">
      <ellipse cx="62" cy="194" rx="26" ry="4" fill="#0E182D" opacity="0.18"></ellipse>
      <GuardFigure />
    </svg>
  </div>

  <ol class="grid gap-5 md:grid-cols-3">
    {
      steps.map((step, index) => (
        <li class="patrol-step relative flex gap-5 md:flex-col md:items-center md:gap-0 md:text-center" data-step>
          {index < steps.length - 1 && (
            <span class="patrol-segment" aria-hidden="true">
              <span class="patrol-fill" />
            </span>
          )}
          <span
            class="patrol-marker relative z-10 grid size-12 shrink-0 place-items-center rounded-full font-display text-sm font-extrabold"
            aria-hidden="true"
          >
            <span class="patrol-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="patrol-check absolute inset-0 grid place-items-center">
              <Icon name="check" class="size-5" strokeWidth={2.5} />
            </span>
          </span>
          <div class="patrol-card w-full flex-1 rounded-2xl border bg-white p-6 sm:p-8 md:mt-6">
            <h3 class="text-xl font-bold">{step.title}</h3>
            <p class="mt-2 leading-relaxed text-navy-500">{step.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .patrol {
    --patrol-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Walking guard – only while the script drives the timeline */
  .patrol-guard {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 20;
    display: none;
    width: 38px;
    height: 63px;
    pointer-events: none;
    will-change: transform;
  }

  .patrol.is-animated .patrol-guard {
    display: block;
  }

  .patrol-guard svg {
    transition: transform 250ms var(--patrol-ease);
  }

  .patrol-guard[data-dir='back'] svg {
    transform: scaleX(-1);
  }

  /* Line segment from this checkpoint to the next one: vertical on mobile, horizontal from md. */
  .patrol-segment {
    position: absolute;
    top: 1.5rem;
    left: calc(1.5rem - 1px);
    width: 2px;
    height: calc(100% + 1.25rem);
    background-image: linear-gradient(to bottom, var(--color-navy-200) 50%, transparent 50%);
    background-size: 2px 10px;
  }

  .patrol-fill {
    position: absolute;
    inset: 0;
    background: var(--color-brand-500);
    transform-origin: top;
    transform: scaleY(var(--fill, 1));
    transition: transform 120ms linear;
  }

  @media (min-width: 48rem) {
    .patrol-guard {
      width: 56px;
      height: 93px;
    }

    .patrol-segment {
      top: calc(1.5rem - 1px);
      left: 50%;
      width: calc(100% + 1.25rem);
      height: 2px;
      background-image: linear-gradient(to right, var(--color-navy-200) 50%, transparent 50%);
      background-size: 10px 2px;
    }

    .patrol-fill {
      transform-origin: left;
      transform: scaleX(var(--fill, 1));
    }
  }

  /* Checkpoint cleared (default state, also without JS or with reduced motion) */
  .patrol-marker {
    border: 2px solid var(--color-brand-500);
    background: var(--color-brand-500);
    color: var(--color-navy-900);
    transition:
      background-color 500ms var(--patrol-ease),
      border-color 500ms var(--patrol-ease),
      color 500ms var(--patrol-ease);
  }

  .patrol-marker::after {
    content: '';
    position: absolute;
    inset: -2px;
    border: 2px solid var(--color-brand-500);
    border-radius: 9999px;
    opacity: 0;
    pointer-events: none;
  }

  .patrol-number,
  .patrol-check {
    transition:
      opacity 400ms var(--patrol-ease),
      transform 500ms var(--patrol-ease);
  }

  .patrol-number {
    opacity: 0;
    transform: scale(0.6);
  }

  .patrol-check {
    opacity: 1;
    transform: scale(1);
  }

  .patrol-card {
    border-color: color-mix(in srgb, var(--color-brand-500) 35%, white);
    box-shadow: 0 18px 40px -24px rgb(14 24 45 / 0.25);
    transition:
      opacity 700ms var(--patrol-ease),
      transform 700ms var(--patrol-ease),
      border-color 700ms var(--patrol-ease),
      box-shadow 700ms var(--patrol-ease);
  }

  /* Waiting for the patrol – only while the script drives the timeline */
  .patrol.is-animated .patrol-step:not([data-reached]) .patrol-marker {
    border-style: dashed;
    border-color: var(--color-navy-200);
    background: white;
    color: var(--color-navy-500);
  }

  .patrol.is-animated .patrol-step:not([data-reached]) .patrol-number {
    opacity: 1;
    transform: scale(1);
  }

  .patrol.is-animated .patrol-step:not([data-reached]) .patrol-check {
    opacity: 0;
    transform: scale(0.6);
  }

  .patrol.is-animated .patrol-step:not([data-reached]) .patrol-card {
    border-color: var(--color-navy-100);
    box-shadow: none;
    opacity: 0.55;
    transform: translateY(12px);
  }

  .patrol.is-animated .patrol-step[data-reached] .patrol-marker {
    animation: patrol-pop 600ms var(--patrol-ease);
  }

  .patrol.is-animated .patrol-step[data-reached] .patrol-marker::after {
    animation: patrol-ring 900ms ease-out;
  }

  @keyframes patrol-pop {
    40% {
      transform: scale(1.15);
    }
  }

  @keyframes patrol-ring {
    from {
      opacity: 0.6;
      transform: scale(1);
    }

    to {
      opacity: 0;
      transform: scale(1.9);
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-patrol]').forEach((root) => {
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
    const markers = steps.map((step) => step.querySelector<HTMLElement>('.patrol-marker'));
    const guard = root.querySelector<HTMLElement>('.patrol-guard');
    // Without animation the timeline keeps its fully drawn default state and the guard stays hidden.
    if (reduceMotion || steps.length < 2 || !guard || markers.some((marker) => !marker)) return;

    root.classList.add('is-animated');
    const clamp = (value: number) => Math.min(Math.max(value, 0), 1);
    const last = steps.length - 1;
    let frame = 0;
    let previousPos = -1;
    let stopTimer = 0;

    // Marker position relative to the root, unaffected by the markers' pop transform.
    const markerPoint = (index: number) => {
      const step = steps[index];
      const marker = markers[index]!;
      return {
        x: step.offsetLeft + marker.offsetLeft + marker.offsetWidth / 2,
        top: step.offsetTop + marker.offsetTop,
      };
    };

    const update = () => {
      frame = 0;
      const rect = root.getBoundingClientRect();
      const vh = window.innerHeight;
      const span = Math.max(rect.height * 0.6, vh * 0.45);
      const progress = clamp((vh * 0.75 - rect.top) / span);

      // The guard only moves in the middle of each segment, so it pauses briefly at every checkpoint.
      const raw = progress * last;
      const segment = Math.min(Math.floor(raw), last - 1);
      const pos = segment + clamp((raw - segment - 0.08) / 0.84);

      steps.forEach((step, index) => {
        step.style.setProperty('--fill', String(clamp(pos - index)));
        step.toggleAttribute('data-reached', progress > 0 && pos >= index);
      });

      const from = Math.min(Math.floor(pos), last - 1);
      const t = pos - from;
      const a = markerPoint(from);
      const b = markerPoint(from + 1);
      const x = a.x + (b.x - a.x) * t;
      const top = a.top + (b.top - a.top) * t;
      guard.style.transform = `translate(${x - guard.offsetWidth / 2}px, ${top - guard.offsetHeight + 4}px)`;

      if (previousPos >= 0 && Math.abs(pos - previousPos) > 0.0005) {
        guard.dataset.dir = pos < previousPos ? 'back' : 'forward';
        guard.classList.add('guard-walking');
        window.clearTimeout(stopTimer);
        stopTimer = window.setTimeout(() => guard.classList.remove('guard-walking'), 180);
      }
      guard.classList.toggle('guard-checking', progress > 0 && Math.abs(pos - Math.round(pos)) < 0.001);
      previousPos = pos;
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  });
</script>
