---
/**
 * Services as a stack of large "book pages": each page sticks below the header and the next one
 * slides over it; covered pages shrink and dim slightly (inspired by brandappart.com).
 */
import Icon from './Icon.astro';
import { serviceIcons, type IconName } from './icons';
import { pagePath, servicePath, useTranslations, type Lang } from '../i18n/ui';
import type { ServiceEntry } from '../lib/services';

interface Props {
  services: ServiceEntry[];
  lang: Lang;
}

const { services, lang } = Astro.props;
const t = useTranslations(lang);
const pad = (index: number) => String(index + 1).padStart(2, '0');
---

<ol class="stack" data-stack>
  {
    services.map((service, index) => {
      const { key, title, summary, highlights } = service.data;
      const icon: IconName = serviceIcons[key];
      return (
        <li class="stack-item" style={`--i: ${index}`}>
          <article class="stack-page relative overflow-hidden rounded-3xl border border-navy-100 bg-white shadow-xl shadow-navy-900/5">
            <div class="grid flex-1 gap-8 p-6 sm:p-10 lg:grid-cols-12 lg:gap-12 lg:p-12">
              <div class="flex flex-col lg:col-span-7">
                <p class="font-display text-sm font-bold tracking-widest text-brand-700">({pad(index)})</p>
                <h3
                  class="mt-3 w-fit text-2xl font-bold sm:text-3xl lg:text-4xl"
                  style={`view-transition-name: service-title-${key}; view-transition-class: service-title`}
                >
                  {title}
                </h3>
                <p class="mt-4 max-w-xl leading-relaxed text-navy-500 sm:text-lg">{summary}</p>
                <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                  {highlights.slice(0, 4).map((item) => (
                    <li class="flex gap-3 text-sm text-navy-700">
                      <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-brand-500 text-navy-900">
                        <Icon name="check" class="size-3.5" strokeWidth={2.5} />
                      </span>
                      {item}
                    </li>
                  ))}
                </ul>
                <div class="mt-8 lg:mt-auto lg:pt-8">
                  <a href={servicePath(key, lang)} class="btn btn-dark">
                    {t.services.learnMore}
                    <Icon name="arrowRight" class="size-4" />
                  </a>
                </div>
              </div>

              <div class="stack-panel relative hidden min-h-48 place-items-center overflow-hidden rounded-2xl bg-navy-900 sm:grid lg:col-span-5">
                <span
                  class="relative z-10 grid size-28 place-items-center rounded-3xl bg-brand-500 text-navy-900 shadow-2xl shadow-black/30 lg:size-36"
                  style={`view-transition-name: service-icon-${key}`}
                >
                  <Icon name={icon} class="size-14 lg:size-18" strokeWidth={1.5} />
                </span>
                <span aria-hidden="true" class="absolute right-5 bottom-2 font-display text-8xl font-extrabold text-white/5 lg:text-9xl">
                  {pad(index)}
                </span>
              </div>
            </div>
          </article>
        </li>
      );
    })
  }

  <li class="stack-item" style={`--i: ${services.length}`}>
    <article class="stack-page relative overflow-hidden rounded-3xl bg-brand-500 shadow-xl shadow-navy-900/10">
      <div class="grid flex-1 gap-8 p-6 sm:p-10 lg:grid-cols-12 lg:gap-12 lg:p-12">
        <div class="flex flex-col lg:col-span-7">
          <p class="font-display text-sm font-bold tracking-widest text-navy-900/70">({pad(services.length)})</p>
          <h3 class="mt-3 text-2xl font-bold sm:text-3xl lg:text-4xl">{t.services.customTitle}</h3>
          <p class="mt-4 max-w-xl leading-relaxed text-navy-800 sm:text-lg">{t.services.customText}</p>
          <div class="mt-8 lg:mt-auto lg:pt-8">
            <a href={pagePath('contact', lang)} class="btn btn-dark">
              {t.nav.requestQuote}
              <Icon name="arrowRight" class="size-4" />
            </a>
          </div>
        </div>

        <div class="stack-panel relative hidden min-h-48 place-items-center overflow-hidden rounded-2xl bg-navy-900 sm:grid lg:col-span-5">
          <span class="relative z-10 grid size-28 place-items-center rounded-3xl bg-brand-500 text-navy-900 shadow-2xl shadow-black/30 lg:size-36">
            <Icon name="shieldCheck" class="size-14 lg:size-18" strokeWidth={1.5} />
          </span>
          <span aria-hidden="true" class="absolute right-5 bottom-2 font-display text-8xl font-extrabold text-white/5 lg:text-9xl">
            {pad(services.length)}
          </span>
        </div>
      </div>
    </article>
  </li>
</ol>

<style>
  .stack-item:not(:last-child) {
    padding-bottom: 12vh;
  }

  .stack-page {
    display: flex;
    flex-direction: column;
    transform-origin: top center;
    transform: scale(calc(1 - 0.06 * var(--covered, 0)));
  }

  /* Uniform page height from tablets up; on phones each page is as tall as its content */
  @media (min-width: 40rem) {
    .stack-page {
      min-height: min(34rem, calc(100dvh - 8rem));
    }
  }

  /* Dims the page as the next one slides over it */
  .stack-page::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-navy-900);
    opacity: calc(0.45 * var(--covered, 0));
    pointer-events: none;
  }

  .stack-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  /* Only stack when the screen is tall enough to show a whole page below the header */
  @media (min-height: 640px) {
    .stack-item {
      position: sticky;
      top: calc(6rem + var(--i) * 1.25rem);
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-stack]').forEach((stack) => {
    // With reduced motion the pages still stack (CSS sticky), just without shrink and dim.
    if (reduceMotion) return;
    const pages = Array.from(stack.querySelectorAll<HTMLElement>('.stack-page'));
    if (pages.length < 2) return;
    let frame = 0;

    const update = () => {
      frame = 0;
      for (let i = 0; i < pages.length - 1; i++) {
        // The scale keeps the top edge in place, and offsetHeight ignores the transform.
        const top = pages[i].getBoundingClientRect().top;
        const height = pages[i].offsetHeight;
        const nextTop = pages[i + 1].getBoundingClientRect().top;
        const covered = Math.min(Math.max((top + height - nextTop) / height, 0), 1);
        pages[i].style.setProperty('--covered', covered.toFixed(3));
      }
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  });
</script>
