---
import ServicePage from '../../../components/pages/ServicePage.astro';
import { serviceSlugs } from '../../../i18n/ui';
import { getServices } from '../../../lib/services';

export async function getStaticPaths() {
  const services = await getServices('en');
  return services.map((service) => ({
    params: { slug: serviceSlugs[service.data.key].en },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<ServicePage lang="en" service={service} />
