---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/ui';

const de = useTranslations('de').notFound;
const en = useTranslations('en').notFound;
---

<BaseLayout lang="de" title={de.title} alternates={null} noindex>
  <section class="section">
    <div class="container-page max-w-2xl text-center">
      <p class="font-display text-7xl font-extrabold text-navy-200" aria-hidden="true">404</p>
      <h1 class="mt-4 text-3xl font-bold sm:text-4xl">{de.title}</h1>
      <p class="mt-4 text-navy-500">{de.text}</p>
      <p class="mt-2 text-navy-500" lang="en">{en.text}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">{de.back}</a>
        <a href="/en/" class="btn btn-outline" lang="en">{en.back}</a>
      </div>
    </div>
  </section>
</BaseLayout>
